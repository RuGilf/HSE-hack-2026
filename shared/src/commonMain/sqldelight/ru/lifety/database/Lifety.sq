import kotlin.Boolean;
import kotlin.Int;

-- Schema version 3: people; migrations preserve all existing data.
CREATE TABLE task (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    scheduledAt INTEGER,
    deadlineAt INTEGER,
    isCompleted INTEGER AS Boolean NOT NULL
);

CREATE TABLE expense (
    id TEXT NOT NULL PRIMARY KEY,
    amountMinor INTEGER NOT NULL,
    currency TEXT NOT NULL,
    merchant TEXT NOT NULL,
    category TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    source TEXT NOT NULL
);

CREATE TABLE healthSnapshot (
    timestamp INTEGER NOT NULL PRIMARY KEY,
    sleepMinutes INTEGER AS Int,
    steps INTEGER AS Int
);

CREATE TABLE expenseCategory (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    colorHex TEXT NOT NULL,
    archived INTEGER AS Boolean NOT NULL DEFAULT 0
);

selectExpenseCategories:
SELECT * FROM expenseCategory ORDER BY id ASC;

upsertExpenseCategory:
INSERT OR REPLACE INTO expenseCategory(id, name, colorHex, archived) VALUES (?, ?, ?, ?);

selectTasks:
SELECT * FROM task ORDER BY id ASC;

upsertTask:
INSERT OR REPLACE INTO task(id, title, scheduledAt, deadlineAt, isCompleted)
VALUES (?, ?, ?, ?, ?);

deleteTask:
DELETE FROM task WHERE id = ?;

selectExpenses:
SELECT * FROM expense ORDER BY timestamp DESC, id ASC;

upsertExpense:
INSERT OR REPLACE INTO expense(id, amountMinor, currency, merchant, category, timestamp, source)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteExpense:
DELETE FROM expense WHERE id = ?;

selectLatestHealth:
SELECT * FROM healthSnapshot ORDER BY timestamp DESC LIMIT 1;

selectHealthHistory:
SELECT * FROM healthSnapshot ORDER BY timestamp DESC;

upsertHealth:
INSERT OR REPLACE INTO healthSnapshot(timestamp, sleepMinutes, steps)
VALUES (?, ?, ?);

CREATE TABLE person (
    id TEXT NOT NULL PRIMARY KEY,
    fullName TEXT NOT NULL,
    birthdayMonth INTEGER AS Int,
    birthdayDay INTEGER AS Int,
    birthYear INTEGER AS Int,
    interests TEXT NOT NULL,
    hobbies TEXT NOT NULL,
    giftIdeas TEXT NOT NULL
);

selectPeople:
SELECT * FROM person ORDER BY fullName COLLATE NOCASE ASC, id ASC;

upsertPerson:
INSERT OR REPLACE INTO person(id, fullName, birthdayMonth, birthdayDay, birthYear, interests, hobbies, giftIdeas)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deletePerson:
DELETE FROM person WHERE id = ?;
