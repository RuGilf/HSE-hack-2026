import kotlin.Boolean;
import kotlin.Int;

-- Schema version 4: goals and imported planning; migrations preserve all existing data.
CREATE TABLE task (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    scheduledAt INTEGER,
    deadlineAt INTEGER,
    isCompleted INTEGER AS Boolean NOT NULL
);

CREATE TABLE expense (
    id TEXT NOT NULL PRIMARY KEY,
    amountMinor INTEGER NOT NULL,
    currency TEXT NOT NULL,
    merchant TEXT NOT NULL,
    category TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    source TEXT NOT NULL,
    note TEXT NOT NULL DEFAULT ''
);

CREATE TABLE healthSnapshot (
    timestamp INTEGER NOT NULL PRIMARY KEY,
    sleepMinutes INTEGER AS Int,
    steps INTEGER AS Int
);

CREATE TABLE expenseCategory (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    colorHex TEXT NOT NULL,
    archived INTEGER AS Boolean NOT NULL DEFAULT 0
);

selectExpenseCategories:
SELECT * FROM expenseCategory ORDER BY id ASC;

upsertExpenseCategory:
INSERT OR REPLACE INTO expenseCategory(id, name, colorHex, archived) VALUES (?, ?, ?, ?);

selectTasks:
SELECT * FROM task ORDER BY id ASC;

upsertTask:
INSERT OR REPLACE INTO task(id, title, scheduledAt, deadlineAt, isCompleted)
VALUES (?, ?, ?, ?, ?);

deleteTask:
DELETE FROM task WHERE id = ?;

selectExpenses:
SELECT * FROM expense ORDER BY timestamp DESC, id ASC;

upsertExpense:
INSERT OR REPLACE INTO expense(id, amountMinor, currency, merchant, category, timestamp, source, note)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteExpense:
DELETE FROM expense WHERE id = ?;

selectLatestHealth:
SELECT * FROM healthSnapshot ORDER BY timestamp DESC LIMIT 1;

selectHealthHistory:
SELECT * FROM healthSnapshot ORDER BY timestamp DESC;

upsertHealth:
INSERT OR REPLACE INTO healthSnapshot(timestamp, sleepMinutes, steps)
VALUES (?, ?, ?);

CREATE TABLE person (
    id TEXT NOT NULL PRIMARY KEY,
    fullName TEXT NOT NULL,
    birthdayMonth INTEGER AS Int,
    birthdayDay INTEGER AS Int,
    birthYear INTEGER AS Int,
    interests TEXT NOT NULL,
    hobbies TEXT NOT NULL,
    giftIdeas TEXT NOT NULL
);

selectPeople:
SELECT * FROM person ORDER BY fullName COLLATE NOCASE ASC, id ASC;

upsertPerson:
INSERT OR REPLACE INTO person(id, fullName, birthdayMonth, birthdayDay, birthYear, interests, hobbies, giftIdeas)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deletePerson:
DELETE FROM person WHERE id = ?;

CREATE TABLE goal (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    targetAt INTEGER,
    isCompleted INTEGER AS Boolean NOT NULL
);
CREATE TABLE taskPlan (
    taskId TEXT NOT NULL PRIMARY KEY,
    durationMinutes INTEGER AS Int NOT NULL,
    approach TEXT NOT NULL,
    goalId TEXT
);
CREATE TABLE planReport (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    summary TEXT NOT NULL,
    importedAt INTEGER NOT NULL
);
selectGoals:
SELECT * FROM goal ORDER BY isCompleted, targetAt IS NULL, targetAt, id;
upsertGoal:
INSERT OR REPLACE INTO goal VALUES (?, ?, ?, ?, ?);
deleteGoal:
DELETE FROM goal WHERE id = ?;
clearGoalLinks:
UPDATE taskPlan SET goalId = NULL WHERE goalId = ?;
selectTaskPlans:
SELECT * FROM taskPlan ORDER BY taskId;
upsertTaskPlan:
INSERT OR REPLACE INTO taskPlan VALUES (?, ?, ?, ?);
deleteTaskPlan:
DELETE FROM taskPlan WHERE taskId = ?;
selectPlanReport:
SELECT summary, importedAt FROM planReport WHERE id = 1;
upsertPlanReport:
INSERT OR REPLACE INTO planReport VALUES (1, ?, ?);

CREATE TABLE chatGptExchange (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    workspace TEXT NOT NULL
);
selectChatGptExchange:
SELECT workspace FROM chatGptExchange WHERE id = 1;
upsertChatGptExchange:
INSERT OR REPLACE INTO chatGptExchange VALUES (1, ?);

CREATE TABLE healthMetric (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    unit TEXT NOT NULL,
    kind TEXT NOT NULL,
    aggregation TEXT NOT NULL,
    sourceKey TEXT UNIQUE,
    archived INTEGER AS Boolean NOT NULL DEFAULT 0
);
CREATE TABLE healthEntry (
    id TEXT NOT NULL PRIMARY KEY,
    metricId TEXT NOT NULL REFERENCES healthMetric(id),
    timestamp INTEGER NOT NULL,
    value TEXT NOT NULL,
    source TEXT NOT NULL
);
CREATE INDEX healthEntryMetricTime ON healthEntry(metricId, timestamp);
CREATE TABLE navigationPreference (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    routes TEXT NOT NULL,
    presentation TEXT NOT NULL DEFAULT 'tabs'
);

selectHealthMetrics:
SELECT * FROM healthMetric ORDER BY id;
selectHealthEntries:
SELECT * FROM healthEntry ORDER BY timestamp, id;
upsertHealthMetric:
INSERT OR REPLACE INTO healthMetric VALUES (?, ?, ?, ?, ?, ?, ?);
upsertHealthEntry:
INSERT OR REPLACE INTO healthEntry VALUES (?, ?, ?, ?, ?);
deleteHealthEntry:
DELETE FROM healthEntry WHERE id = ?;
selectNavigationPreference:
SELECT routes FROM navigationPreference WHERE id = 1;
upsertNavigationPreference:
INSERT OR REPLACE INTO navigationPreference(id, routes, presentation)
VALUES (1, ?, COALESCE((SELECT presentation FROM navigationPreference WHERE id = 1), 'tabs'));

selectNavigationPresentation:
SELECT presentation FROM navigationPreference WHERE id = 1;

upsertNavigationConfiguration:
INSERT OR REPLACE INTO navigationPreference(id, routes, presentation) VALUES (1, ?, ?);

-- Fixed timetable, independent of task estimates and completion.
CREATE TABLE scheduleBlock (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    startMinute INTEGER NOT NULL,
    endMinute INTEGER NOT NULL,
    weekdays INTEGER NOT NULL,
    date TEXT
);
selectScheduleBlocks:
SELECT * FROM scheduleBlock ORDER BY startMinute, id;
upsertScheduleBlock:
INSERT OR REPLACE INTO scheduleBlock VALUES (?, ?, ?, ?, ?, ?);
deleteScheduleBlock:
DELETE FROM scheduleBlock WHERE id = ?;
