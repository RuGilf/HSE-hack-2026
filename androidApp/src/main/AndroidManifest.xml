<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- SDK client is never loaded below API 28; its bound service is also gated. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
    <application
        android:name=".LifetyApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_lifety"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lifety">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize" />
        <activity-alias android:name=".LauncherLifety" android:targetActivity=".MainActivity"
            android:enabled="true" android:exported="true"
            android:icon="@drawable/ic_lifety" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherTokyoNight" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_lifety_tokyo_night" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherCatppuccin" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_lifety_catppuccin" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherGruvbox" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_lifety_gruvbox" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherNord" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_lifety_nord" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name="ru.lifety.feature.health.HealthPermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ru.lifety.feature.health.ViewHealthPermissionUsageActivity"
            android:targetActivity="ru.lifety.feature.health.HealthPermissionsRationaleActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <service
            android:name="androidx.health.platform.client.impl.sdkservice.HealthDataSdkService"
            android:enabled="@bool/lifety_health_connect_enabled"
            tools:replace="android:enabled" />
        <service
            android:name="ru.lifety.platform.notifications.ExpenseNotificationListener"
            android:label="Lifety — импорт расходов"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
